<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F8B76A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111B23</item>
        <item name="android:statusBarColor">#111B23</item>
        <item name="android:navigationBarColor">#111B23</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Body">
        <item name="android:textColor">#AAB9C6</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="SectionTitle">
        <item name="android:textColor">#F4F1EB</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PresetButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#F8B76A</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
